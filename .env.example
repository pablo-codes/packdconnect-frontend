# API URL (Optional, handled by Vite proxy in development)
VITE_API_URL=http://localhost:3000

# WebSocket URL for real-time signaling and chat
VITE_WS_URL=ws://localhost:3000

# WebRTC STUN/TURN Servers
VITE_STUN_SERVER=stun:stun.l.google.com:19302
VITE_TURN_SERVER=turn:turn.example.com:3478
VITE_TURN_USERNAME=your_turn_username
VITE_TURN_PASSWORD=your_turn_password
